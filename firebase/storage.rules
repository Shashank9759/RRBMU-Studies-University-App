rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    match /papers/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /covers/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ads/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /course_backgrounds/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notification_attachments/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
